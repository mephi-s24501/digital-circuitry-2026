root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 4

[*.sh]
indent_size = 2

[*.{vhd,vhdl}]
indent_size = 2

[*.{qsf,sdc}]
indent_size = 2
